[global]
	### Monitor Focus ###
	follow = keyboard

	### Geometry ###
	width = (0, 400)
	offset = (10, 20)

	### Progress bar ###
	progress_bar = true
	progress_bar_height = 5
	progress_bar_frame_width = 0
	progress_bar_min_width = 0
	progress_bar_max_width = 400

	### Looks ###
	frame_width = 2
	gap_size = 4
	corner_radius = 4

	### Text ###
	font = JetBrainsMono Nerd Font 12

	### Icons ###
	enable_recursive_icon_lookup = true
	icon_theme = candy-icons
	min_icon_size = 32
	max_icon_size = 32

	### Behaviour ###
	stack_duplicates = false

[urgency_low]
	timeout = 5
	default_icon = gnome-info

[urgency_normal]
	timeout = 5
	default_icon = gnome-info

[urgency_critical]
	timeout = 0
	default_icon = gnome-warning
