set selection-clipboard clipboard
set selection-notification false

set highlight-active-color rgba(120,140,255,0.5)
set highlight-color rgba(150,200,255,0.5)

set font "JetBrainsMono Nerd Font"

set recolor true

set scroll-step 100

map d scroll half-down
map u scroll half-up
map e scroll half-up
map <C-d> toggle_page_mode
