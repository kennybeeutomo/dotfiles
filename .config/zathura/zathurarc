include "../../../.cache/wal/colors-zathura"

set selection-clipboard clipboard
set selection-notification false

# set font "JetBrainsMono Nerd Font"

set recolor true
set recolor-keephue true
set recolor-reverse-video true

set scroll-step 100

set guioptions ''

map d scroll half-down
map u scroll half-up
map e scroll half-up
map <C-e> feedkeys :source<Return>
map <Space> toggle_fullscreen
map <S-Space> toggle_page_mode

map [fullscreen] d scroll half-down
map [fullscreen] u scroll half-up
map [fullscreen] e scroll half-up
map [fullscreen] <C-e> feedkeys :source<Return>
map [fullscreen] <Space> toggle_fullscreen
map [fullscreen] <S-Space> toggle_page_mode
