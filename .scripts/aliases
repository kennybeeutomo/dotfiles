# Not suited for non-interactive shells

alias grep='grep --color=auto'
alias nvimpager='nvimpager -p'
alias more='nvimpager'
alias less='nvimpager'

alias ls='eza -hF --color=auto --icons=auto'
alias lr='ls -R'
alias ll='ls -l'
alias la='ll -A'
alias lx='ll -BX'
alias lz='ll -rS'
alias lt='ll --sort=modified'
alias lss='ll --sort=size'
alias lm='la | nvimpager'

alias tree='ls --tree'

alias fehbg='feh --bg-fill'
alias rofi='rofi -x11'

alias gengrubcfg='sudo grub-mkconfig -o /boot/grub/grub.cfg'

alias cls=' echo -ne "\033c"'

alias cd='z'

alias cat='bat'

alias man='man -P nvimpager'
alias info='info --vi-keys'

alias fetch='fastfetch'

t() {
	trans "$@" | nvimpager
}

alias snvim="sudo -E nvim"

alias cfz='nvim $HOME/.config/zsh/.zshrc'
alias cfh='nvim $HOME/.config/hypr'
alias cfn='nvim $HOME/.config/nvim'
alias cfy='nvim $HOME/.config/yazi'
alias cfu='nvim $HOME/.config/uwsm'
alias cfa='nvim $HOME/.scripts/aliases'
alias cfw='nvim $HOME/.config/waybar'
alias cfr='nvim $HOME/.config/rofi'
alias cfs='nvim $HOME/.scripts'

alias todo='nvim -c "Neorg workspace todo"'
alias notes='nvim -c "Neorg workspace notes"'

alias nmconnect='nmcli --ask device wifi connect'

alias nvidia-settings='nvidia-settings --config="$XDG_CONFIG_HOME"/nvidia/settings'

alias wayvnc='wayvnc -d -v -g -p'

alias gdb='gdb -q'
alias pipes='pipes.sh -K -R -s 15 -p 4 -c 1 -c 2 -c 3 -c 4 -c 5 -c 6 -c 7'

alias lgit='lazygit'

touchx() {
	touch "$@" && chmod +x "$@"
}
