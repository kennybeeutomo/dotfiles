alias man='man -P nvimpager'
alias info='info --vi-keys'

alias fetch='fastfetch'

alias trans="trans -pager nvimpager"

alias snvim="sudo -E nvim"

alias cfz='nvim .config/zsh/.zshrc'
alias cfh='nvim .config/hypr'
alias cfn='nvim .config/nvim'
alias cfy='nvim .config/yazi'
alias cfu='nvim .config/uwsm'
alias cfa='nvim .scripts/aliases'
alias cfw='nvim .config/waybar'
alias cfr='nvim .config/rofi'

alias nmconnect='nmcli --ask device wifi connect'

alias nvidia-settings='nvidia-settings --config="$XDG_CONFIG_HOME"/nvidia/settings'

alias wayvnc='wayvnc -d -v -g -p'
