# Short utility functions that don't deserve their own script files

optionsDir="$XDG_DATA_HOME/dotfiles"

# dotlog <message>
dotlog() {
	local logDir="$XDG_CACHE_HOME/dotfiles"
	[ -d "$logDir" ] || mkdir -p "$logDir"
	echo "$(date +'%Y-%m-%d-%H-%M-%S-%N'): $*" >> "$logDir/log.txt"
}

# setoption <option> <value>
setoption() {
	mkdir -p "$optionsDir"
	echo "$2" > "$optionsDir/$1"
}

# getoption <option> [<default value if option is not found>]
getoption() {
	if [ -f "$optionsDir/$1" ]; then
		\cat "$optionsDir/$1"
	else
		[ -n "$2" ] && echo "$2"
	fi
}

die() {
	dunstify -i 0 "$@"
	exit 1
}

success() {
	dunstify -i 0 "$@"
	exit 0
}

pickimg() {
	swiv -t -o -b -N pickimg "$@"
}

swww-img() {
	swww img -t grow --transition-pos top-right --transition-step 13 --transition-fps 144 --transition-duration 0.5 "$@"
}

# wwal <wallpaper> | auto
# run pywal with dotfiles options
wwal() {
	local cmd='wal --cols16 lighten -n -s'

	local wallpaper="$1"; shift
	[ "$wallpaper" = auto ] && wallpaper="$(cat ~/.cache/wal/wal)"
	[ ! -f "$wallpaper" ] && return 1
	cmd+=" -i '$wallpaper'"

	# shellcheck disable=SC2155
	local backend=$(getoption walbackend wal)
	cmd+=" --backend '$backend'"

	# shellcheck disable=SC2155
	local saturation=$(getoption walsaturation None)

	case "$saturation" in
		None )
			;;
		0.[0-9] | 1.0 )
			cmd+=" --saturate '$saturation'"
			;;
		* )
			echo 'Invalid saturation'
			return 1
			;;
	esac

	cmd+="$*"

	dotlog "$cmd"
	eval "$cmd"
}

# run wwal and update colorthemes of other programs
pywal() {
	local pywalLockFile="$optionsDir/pywal-lock"

	[ -f "$pywalLockFile" ] && die 'Pywal in process'

	# shellcheck disable=SC2064
	trap "rm '$pywalLockFile'" EXIT

	touch "$pywalLockFile"

	wwal "$@" || return 1
	killall -SIGUSR1 nvim -q &
	wbctl.sh reload &

	# reloading while notifications are active breaks dunst
	dunstctl close-all
	dunstctl reload
}

# pywal and change wallpaper
chwal() {
	pywal "$1" &
	swww-img "$1"
}

# alias of rofi-dmenu
rmenu() {
	rofi -x11 -dmenu -i -no-custom "$@"
}

# alias of rofi-dmenu with vim bindings
vmenu() {
	local rofiConfig="$HOME/.config/rofi/config-vi.rasi"
	rmenu -config "$rofiConfig" "$@"
}

# optionmenu (rmenu | vmenu) <prompt msg> <option to modify> (<option> ...)
# Opens rofi that lists every <option> and sets <option to modify> to the selected one
optionmenu() {
	local rofimode=$1; shift # rmenu | vmenu
	local prompt=$1; shift
	local option=$1; shift

	# shellcheck disable=SC2155
	local optionValue=$(getoption "$option")

	local options=("$@")

	IFS=$'\n'
	# shellcheck disable=SC2155
	local choice=$(echo "${options[*]}" | "$rofimode" -select "$optionValue" -p "$prompt")
	IFS=' '

	[ -n "$choice" ] && eval setoption '$option' '$choice'
}

# persisterm <working dir> <class> <command>
# Start command in a new terminal, and don't exit terminal when the command exits
persisterm() {
	local wd=$1; shift
	local class=$1; shift
	[ ! -d "$wd" ] && return 1
	[ "$class" = '-' ] && class='persisterm'
	NOFETCH=1 alacritty --class "$class" --working-directory "$wd" -e zsh -c "$*; zsh"
}

# persistvim <class> <file>
# Nvim in persistent terminal
persistvim() {
	local class=$1; shift
	local file=$1; shift
	local wd; wd=$(dirname "$file")
	[ ! -e "$file" ] && return 1
	[ -d "$file" ] && wd=$file
	persisterm "$wd" "$class" "nvim '$file'" "$@"
}

# execfor <cmd> (<file> ...)
# Executes <cmd> for each <file>
execfor() {
	local cmd=$1
	shift
	local files=("$@")
	for f in "${files[@]}"; do
		eval "$cmd \"$f\""
	done
}

# jqCopyValue <src> <dest> <variable>
# Copy the value of <variable> from <src> to <dest>
jqCopyValue() {
	local src=$1
	local dest=$2
	local var=$3

	local srcValue; srcValue=$(jq "$var" "$src") || return 1
	local result; result=$(jq "$var |= $srcValue" "$dest") || return 1
	echo "$result" > "$dest"
}

# jqEqualValue <file a> <file b> <variable>
# Test if the value of <variable> in <file a> and in <file b> is equal
jqEqualValue() {
	local a=$1
	local b=$2
	local var=$3

	local aValue; aValue=$(jq "$var" "$a") || return 1
	local bValue; bValue=$(jq "$var" "$b") || return 1

	[ "$aValue" = "$bValue" ]
}

# code <type> <project name>
# Generates code project from template
code() {
	templatesDir="$HOME/.scripts/code-templates"
	filetype=$1
	projectname=$2

	[ ! -d "$templatesDir/$filetype" ] && echo 'invalid filetype' && return 1

	cp -r "$templatesDir/$filetype" "./$projectname"
	find "./$projectname" -type f -exec sed -i "s/{PROGRAM_NAME}/$projectname/g" {} ';'

	local files
	files=$(find "./$projectname" -name '{PROGRAM_NAME}')
	for file in $files; do
		rename -a '{PROGRAM_NAME}' "$projectname" "$file"
	done
}
