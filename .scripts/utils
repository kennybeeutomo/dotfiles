# Short utility functions that don't deserve their own script files

optionsDir="$XDG_DATA_HOME/dotfiles"

setoption() {
	mkdir -p "$optionsDir"
	echo "$2" > "$optionsDir/$1"
}

# getoption <option> [<default value if option is not found>]
getoption() {
	if [ -f "$optionsDir/$1" ]; then
		\cat "$optionsDir/$1"
	else
		[ -n "$2" ] && echo "$2"
	fi
}

pickimg() {
	swiv -t -o -b -N pickimg "$@"
}

swww-img() {
	swww img -t grow --transition-pos top-right --transition-step 13 --transition-fps 144 --transition-duration 0.5 "$1"
}

wwal() {
	local cmd='wal --cols16 lighten -n -s'

	# shellcheck disable=SC2155
	local backend=$(getoption walbackend wal)
	cmd+=" --backend '$backend'"

	# shellcheck disable=SC2155
	local saturation=$(getoption walsaturation None)

	local wallpaper="$1"
	[ "$wallpaper" = auto ] && wallpaper="$(cat ~/.cache/wal/wal)"
	cmd+=" -i '$wallpaper'"

	case "$saturation" in
		None )
			;;
		0.[0-9] | 1.0 )
			cmd+=" --saturate '$saturation'"
			;;
		* )
			echo 'Invalid saturation'
			return 1
			;;
	esac

	eval "$cmd"
}

pywal() {
	wwal "$1" || return 1
	wbctl.sh reload
	killall -SIGUSR1 nvim -q

	# reloading while notifications are active breaks dunst
	dunstctl close-all
	dunstctl reload
}

chwal() {
	pywal "$1"
	swww-img "$1"
}

rmenu() {
	rofi -x11 -dmenu -i -no-custom "$@"
}

vmenu() {
	local rofiConfig="$HOME/.config/rofi/config-vi.rasi"
	rmenu -config "$rofiConfig" "$@"
}

die() {
	dunstify -i 0 "$1"
	exit 1
}

success() {
	dunstify -i 0 "$1"
	exit 0
}

execfor() {
	cmd=$1
	shift
	files=("$@")
	for f in "${files[@]}"; do
		eval "$cmd \"$f\""
	done
}

jqCopyValue() {
	a=$1
	b=$2
	var=$3

	aValue=$(jq "$var" "$a")
	result=$(jq "$var |= $aValue" "$b")
	echo "$result" > "$b"
}

jqEqualValue() {
	a=$1
	b=$2
	var=$3

	aValue=$(jq "$var" "$a")
	bValue=$(jq "$var" "$b")

	[ "$aValue" = "$bValue" ]
}
